{
  "name": "codex-switcher",
  "private": true,
  "version": "0.1.32",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "opencodex:prepare": "npm ci --prefix opencodex-engine --omit=dev --no-audit --no-fund",
    "opencodex:test": "opencodex-engine/node_modules/bun/bin/bun.exe test ./opencodex-engine/manager-engine-update.test.ts ./opencodex-engine/manager-switcher-import.test.ts ./opencodex-engine/manager-service-status.test.ts ./opencodex-engine/manager-instance-integration.test.ts",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "dompurify": "^3.4.13",
    "echarts": "^6.1.0",
    "marked": "^18.0.9",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vue-tsc": "^3.0.0"
  }
}
